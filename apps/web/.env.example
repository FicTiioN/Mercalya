# URL base da API. Sem isso, cai no padrao http://localhost:3000/api
VITE_API_URL="http://localhost:3000/api"

# Provedor de pagamento que o totem (/totem) aciona. "simulado" e a maquininha
# que nao existe: aprova pelo painel de controle na propria tela. Quando houver
# um adquirente real, o nome do adaptador entra aqui.
VITE_PROVEDOR_PAGAMENTO="simulado"
