# Ambiente: development | test | production (padrao: development).
# Em production a API nao sobe com JWT_SECRET de exemplo ou curto, nem sem
# CORS_ORIGIN. Em development os mesmos problemas viram so aviso no log.
NODE_ENV=development

# --------------------------------------------------------------------------
# Banco
#
# Esta maquina ja tem um Postgres nativo escutando na 5432 (servico do
# Windows), entao o docker-compose publica a 5433 para nao conflitar.
#
# Opcao A - Postgres do docker-compose (porta 5433):
DATABASE_URL="postgresql://mercalya:mercalya@localhost:5433/mercalya?schema=public"
#
# Opcao B - Postgres ja instalado na maquina (porta 5432). Crie o banco e
# troque usuario/senha pelos seus:
# DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/mercalya?schema=public"
# --------------------------------------------------------------------------

# Banco dos testes de integracao (npm test). Se ausente, usa o DATABASE_URL
# com sufixo "_test" no mesmo servidor — criado sozinho na primeira execucao.
# DATABASE_URL_TEST="postgresql://mercalya:mercalya@localhost:5433/mercalya_test?schema=public"

# Maquininha simulada: quanto tempo uma intencao fica pendente antes de o
# terminal decidir sozinho (centavos .99 recusam, .98 nunca respondem). O
# endpoint POST /pagamentos/:id/simulador/aprovar|recusar decide na hora.
PAGAMENTO_SIMULADO_ATRASO_MS=3000

PORT=3000

# Quantos proxies ficam entre o cliente e a API (o balanceador da hospedagem
# conta como 1). Define de onde vem o IP real usado no limite de login.
# Local, sem proxy: 0. Atras de balanceador: 1. Errado para mais, qualquer
# cliente falsifica o IP; para menos, todos parecem vir do mesmo IP.
TRUST_PROXY=0

# Origens liberadas no CORS, separadas por virgula
CORS_ORIGIN="http://localhost:5173"

# Segredo do JWT, minimo de 32 caracteres. Gere o seu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-me"
JWT_EXPIRA_EM="12h"

# db:seed e db:nova-conta escrevem direto no banco e so rodam com banco em
# localhost fora de production. Para rodar em outro banco (ex.: criar a conta
# de demonstracao no staging), libere de proposito so naquele comando:
#   PERMITIR_SEED=sim npm run db:nova-conta -- --nome "Demo" --email demo@x.com --senha ...
# Nunca deixe esta variavel definida aqui.
