# --------------------------------------------------------------------------
# Banco
#
# Esta maquina ja tem um Postgres nativo escutando na 5432 (servico do
# Windows), entao o docker-compose publica a 5433 para nao conflitar.
#
# Opcao A - Postgres do docker-compose (porta 5433):
DATABASE_URL="postgresql://mercalya:mercalya@localhost:5433/mercalya?schema=public"
#
# Opcao B - Postgres ja instalado na maquina (porta 5432). Crie o banco e
# troque usuario/senha pelos seus:
# DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/mercalya?schema=public"
# --------------------------------------------------------------------------

PORT=3000
# Origens liberadas no CORS, separadas por virgula
CORS_ORIGIN="http://localhost:5173"

# Segredo do JWT. Gere o seu: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-me"
JWT_EXPIRA_EM="12h"
